# ============================================================================
# WABA Lakehouse — variables d'environnement (valeurs d'EXEMPLE uniquement)
# Copier ce fichier :  cp .env.example .env   (PowerShell : Copy-Item .env.example .env)
# puis remplacer chaque valeur "change-me". Le fichier .env est ignoré par Git.
# ============================================================================

# --- MinIO : compte administrateur (utilisé uniquement par minio-init) -------
MINIO_ROOT_USER=waba-admin
MINIO_ROOT_PASSWORD=change-me-admin-min-8-chars

# --- MinIO : compte de service applicatif (Streamlit, Spark, Iceberg, Trino) -
LAKEHOUSE_ACCESS_KEY=lakehouse-svc
LAKEHOUSE_SECRET_KEY=change-me-svc-min-8-chars
AWS_REGION=us-east-1

# --- Sécurité des données ----------------------------------------------------
# Sel secret pour la pseudonymisation SHA-256 des données sensibles (IBAN).
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_SALT=change-me-random-64-hex-chars

# --- Ressources Spark (VM 8 vCPU / 19 Go) ---------------------------------------
# batch : 4 cœurs / 2 x 3g ; streaming : 2 cœurs / 1,5g par job (Level 3) -> 8 cœurs / 9g
SPARK_WORKER_CORES=8
SPARK_WORKER_MEMORY=9g

# --- Level 2 : Airflow --------------------------------------------------------
# Générer automatiquement toutes les valeurs manquantes : ./scripts/gen-secrets.sh
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-ui
AIRFLOW_DB_PASSWORD=change-me-airflow-db
AIRFLOW_FERNET_KEY=change-me-fernet-base64-32-bytes
AIRFLOW_JWT_SECRET=change-me-jwt
AIRFLOW_API_SECRET_KEY=change-me-api

# --- Level 3 : NiFi (interface https://<IP-VM>:8443/nifi) ---------------------
# ./scripts/gen-secrets.sh génère ces valeurs (NiFi exige 12 caractères minimum)
NIFI_ADMIN_USER=admin
NIFI_ADMIN_PASSWORD=change-me-nifi-12-chars-min
NIFI_SENSITIVE_PROPS_KEY=change-me-nifi-props-key
VM_HOST_IP=192.168.127.128

# --- Level 4 : base PostgreSQL du catalogue Iceberg (Kubernetes) ---------------
ICEBERG_DB_PASSWORD=change-me-iceberg-db

# --- Level 4 : Superset (étape 9.5) — générés par scripts/gen-secrets.sh
SUPERSET_SECRET_KEY=change-me-superset-secret
SUPERSET_DB_PASSWORD=change-me-superset-db
SUPERSET_ADMIN_PASSWORD=change-me-superset-ui

# --- Level 4 : Keycloak / SSO (étape 9.6) — générés par scripts/gen-secrets.sh
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_DEMO_PASSWORD=change-me-demo-users
SUPERSET_OIDC_SECRET=change-me-superset-oidc
TRINO_OIDC_SECRET=change-me-trino-oidc
TRINO_SHARED_SECRET=change-me-trino-internal

# --- Level 4 : OpenMetadata (étape 9.6b) — générés par scripts/gen-secrets.sh
OM_DB_PASSWORD=change-me-om-db
OM_FERNET_KEY=change-me-om-fernet
OM_ADMIN_PASSWORD=change-me-om-admin
