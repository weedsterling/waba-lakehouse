{
  "uid": "waba-supervision",
  "title": "WABA — Supervision plateforme",
  "description": "Flux temps réel, lag Kafka, reporting réglementaire, ressources et journaux (9.7)",
  "tags": [
    "waba",
    "observabilite"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Job fraude / AML (stream-silver-gold)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(waba_sparkapp_state{namespace=\"processing\", name=\"stream-silver-gold\", state=\"RUNNING\"}) or on() vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "SparkApplication stream-silver-gold (kube-state-metrics). Alerte si hors RUNNING > 5 min (job fraude).",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "EN COURS",
                  "color": "green"
                },
                "0": {
                  "text": "ARRÊTÉ / EN ERREUR",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Job ingestion temps réel (stream-raw-silver)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(waba_sparkapp_state{namespace=\"processing\", name=\"stream-raw-silver\", state=\"RUNNING\"}) or on() vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "SparkApplication stream-raw-silver (kube-state-metrics). Alerte si hors RUNNING > 5 min (job fraude).",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "EN COURS",
                  "color": "green"
                },
                "0": {
                  "text": "ARRÊTÉ / EN ERREUR",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lag consumer AML (messages)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"waba-spark-rules\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "Messages silver-* non traités par la requête « rules » (groupe waba-spark-rules). Seuil 5 000.",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2500
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rapport réglementaire — dernière exécution",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE((SELECT state FROM dag_run WHERE dag_id = 'dag_regulatory_report' ORDER BY id DESC LIMIT 1), 'aucune') AS etat"
        }
      ],
      "description": "dag_regulatory_report (00h30 UTC). Alerte si pas de succès du jour à 06h00 UTC.",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^etat$/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "success": {
                  "text": "SUCCÈS",
                  "color": "green"
                },
                "failed": {
                  "text": "ÉCHEC",
                  "color": "red"
                },
                "running": {
                  "text": "EN COURS",
                  "color": "blue"
                },
                "queued": {
                  "text": "EN ATTENTE",
                  "color": "blue"
                },
                "aucune": {
                  "text": "AUCUNE",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "alertlist",
      "title": "Alertes WABA",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "targets": [],
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 10,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "error": true,
          "normal": true
        },
        "alertInstanceLabelFilter": "{domaine=~\"fraude|aml|reglementaire\"}",
        "showInstances": false,
        "folder": null
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lag par groupe de consommateurs Spark",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{consumergroup=~\"waba-spark-.*\"})",
          "legendFormat": "{{consumergroup}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Débit des topics Kafka (messages/s)",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic=~\"(raw|silver|gold|dlq)-.*\"}[5m]))",
          "legendFormat": "{{topic}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Mémoire par domaine (namespace)",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace) (container_memory_working_set_bytes{job=\"kubelet\", namespace=~\"ingestion|processing|serving|governance|monitoring\", container=\"\", pod!=\"\"})",
          "legendFormat": "{{namespace}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Dernières exécutions Airflow",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT dag_id, state, start_date, end_date, run_id FROM dag_run ORDER BY id DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green"
                      },
                      "failed": {
                        "color": "red"
                      },
                      "running": {
                        "color": "blue"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Journaux en erreur / avertissement (Loki)",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=~\"ingestion|processing|serving|governance|monitoring\"} |~ `(?i)(\\berror\\b|\\bwarn(ing)?\\b|exception|traceback)`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
