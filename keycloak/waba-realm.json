{
  "realm": "waba",
  "displayName": "WABA Group",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(12)",
  "roles": {
    "realm": [
      {
        "name": "group_admin",
        "description": "Administration groupe : toutes entités, tous pays"
      },
      {
        "name": "country_analyst",
        "description": "Analyste pays : données restreintes à son pays (rôle country_XX)"
      },
      {
        "name": "compliance_officer",
        "description": "Conformité : tables et tableaux de bord réglementaires uniquement"
      },
      {
        "name": "viewer",
        "description": "Lecture des tableaux de bord agrégés, aucune donnée sensible"
      },
      {
        "name": "country_CI",
        "description": "Périmètre pays CI (Row Level Security)"
      },
      {
        "name": "country_SN",
        "description": "Périmètre pays SN (Row Level Security)"
      },
      {
        "name": "country_ML",
        "description": "Périmètre pays ML (Row Level Security)"
      },
      {
        "name": "country_BF",
        "description": "Périmètre pays BF (Row Level Security)"
      },
      {
        "name": "country_GN",
        "description": "Périmètre pays GN (Row Level Security)"
      },
      {
        "name": "country_TG",
        "description": "Périmètre pays TG (Row Level Security)"
      },
      {
        "name": "country_BJ",
        "description": "Périmètre pays BJ (Row Level Security)"
      },
      {
        "name": "country_GH",
        "description": "Périmètre pays GH (Row Level Security)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "superset",
      "name": "superset",
      "description": "Superset (SSO OIDC)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SUPERSET_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://superset.waba.local",
      "baseUrl": "http://superset.waba.local",
      "redirectUris": [
        "http://superset.waba.local/*"
      ],
      "webOrigins": [
        "http://superset.waba.local"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://superset.waba.local/*",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-as-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "groups",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-superset",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "superset",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "trino",
      "name": "trino",
      "description": "Trino Web UI (OAuth2)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TRINO_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://trino.waba.local",
      "baseUrl": "https://trino.waba.local",
      "redirectUris": [
        "https://trino.waba.local/*"
      ],
      "webOrigins": [
        "https://trino.waba.local"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://trino.waba.local/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-as-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "groups",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-trino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "trino",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.groupe",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Awa",
      "lastName": "Konan",
      "email": "admin.groupe@waba.local",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "group_admin"
      ]
    },
    {
      "username": "analyste.ci",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Yao",
      "lastName": "Kouassi",
      "email": "analyste.ci@waba.local",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "country_analyst",
        "country_CI"
      ]
    },
    {
      "username": "analyste.sn",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Fatou",
      "lastName": "Diop",
      "email": "analyste.sn@waba.local",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "country_analyst",
        "country_SN"
      ]
    },
    {
      "username": "conformite",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Moussa",
      "lastName": "Traoré",
      "email": "conformite@waba.local",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "compliance_officer"
      ]
    },
    {
      "username": "lecteur",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Aminata",
      "lastName": "Bamba",
      "email": "lecteur@waba.local",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ]
    }
  ]
}